                        <tr>
                            <td style="color:orange;">what is kickboxing?</td>
                        </tr>
                        <tr>
                            <td style="text-align:center;">
                                <img src="images/kickboxing.jpeg" style="width:90%;height:580px;border-radius:5px;" />
